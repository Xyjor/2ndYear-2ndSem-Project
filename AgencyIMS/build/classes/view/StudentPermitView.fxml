<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720.0" prefWidth="860.0" stylesheets="/view/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.StudentPermitViewController">
    <children>
        <Label layoutX="30.0" layoutY="30.0" styleClass="header-label" text="Student Permit Management" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />
        <TextField fx:id="txtSearch" layoutX="530.0" layoutY="48.0" prefWidth="300.0" promptText="Search permit number, customer ID, status..." style="-fx-background-radius: 15px; -fx-padding: 5px 15px;" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="48.0" />

        <TableView fx:id="tvPermits" layoutX="30.0" layoutY="81.0" onMouseClicked="#handleTableClick" prefHeight="370.0" prefWidth="800.0" AnchorPane.bottomAnchor="250.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="81.0">
            <columns>
                <TableColumn fx:id="colPermitNum" prefWidth="150.0" text="Permit Number" />
                <TableColumn fx:id="colCustomerId" prefWidth="100.0" text="Customer ID" />
                <TableColumn fx:id="colIssueDate" prefWidth="150.0" text="Issue Date" />
                <TableColumn fx:id="colExpiryDate" prefWidth="150.0" text="Expiry Date" />
                <TableColumn fx:id="colStatus" prefWidth="150.0" text="Status" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label layoutX="24.0" layoutY="492.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Manage Permit Details" AnchorPane.bottomAnchor="200.79999999999995" AnchorPane.leftAnchor="24.0" />

        <TextField fx:id="txtPermitNum" layoutX="30.0" layoutY="540.0" prefWidth="180.0" promptText="Permit Number (e.g., SP-123)" AnchorPane.bottomAnchor="154.39999999999998" AnchorPane.leftAnchor="30.0" />
        <TextField fx:id="txtCustomerId" layoutX="235.0" layoutY="540.0" prefHeight="26.0" prefWidth="180.0" promptText="Customer ID" AnchorPane.bottomAnchor="154.0" AnchorPane.leftAnchor="235.0" />
        <ComboBox fx:id="cmbStatus" layoutX="446.0" layoutY="539.0" prefWidth="150.0" promptText="Select Status" AnchorPane.bottomAnchor="155.39999999999998" AnchorPane.leftAnchor="446.0" />

        <DatePicker fx:id="dpIssueDate" layoutX="30.0" layoutY="590.0" prefWidth="180.0" promptText="Issue Date" AnchorPane.bottomAnchor="104.4" AnchorPane.leftAnchor="30.0" />
        <DatePicker fx:id="dpExpiryDate" layoutX="235.0" layoutY="589.0" prefWidth="180.0" promptText="Expiry Date" AnchorPane.bottomAnchor="105.39999999999998" AnchorPane.leftAnchor="235.0" />

        <Button layoutX="30.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleSavePermit" prefWidth="110.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Save New" AnchorPane.bottomAnchor="50.4" AnchorPane.leftAnchor="30.0" />
        <Button layoutX="149.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleUpdatePermit" prefWidth="110.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Update" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="149.0" />
        <Button layoutX="270.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleClearForm" prefWidth="110.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Clear" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="270.0" />
        <Button layoutX="391.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleDeletePermit" prefWidth="110.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Delete" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="391.0" />
    </children>
</AnchorPane>
