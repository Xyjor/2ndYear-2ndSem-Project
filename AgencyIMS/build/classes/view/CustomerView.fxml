<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720.0" prefWidth="860.0" stylesheets="/view/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.CustomerViewController">
    <children>
        <Label layoutX="30.0" layoutY="30.0" styleClass="header-label" text="Customer Management" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />
        
        <TextField fx:id="txtSearch" layoutX="530.0" layoutY="48.0" prefWidth="300.0" promptText="🔍 Search by Name, ID, or Phone Number..." style="-fx-background-radius: 15px; -fx-padding: 5px 15px;" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="48.0" />
      
        <TableView fx:id="tvCustomers" layoutX="30.0" layoutY="80.0" onMouseClicked="#handleTableClick" prefHeight="400.0" prefWidth="800.0" AnchorPane.bottomAnchor="240.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="29.600000000000023" AnchorPane.topAnchor="80.0">
            <columns>
                <TableColumn fx:id="colCustomerId" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colFirstName" prefWidth="130.0" text="First Name" />
                <TableColumn fx:id="colLastName" prefWidth="130.0" text="Last Name" />
                <TableColumn fx:id="colDob" prefWidth="120.0" text="Date of Birth" />
                <TableColumn fx:id="colAddress" prefWidth="200.0" text="Address" />
                <TableColumn fx:id="colContact" prefWidth="130.0" text="Contact No." />
            </columns>
        </TableView>

        <Label layoutX="31.0" layoutY="499.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Manage Customer Details" AnchorPane.bottomAnchor="193.79999999999995" AnchorPane.leftAnchor="31.0" />
      
        <TextField fx:id="txtCustomerId" disable="true" layoutX="30.0" layoutY="540.0" prefHeight="26.0" prefWidth="160.0" promptText="Auto-Generated ID" AnchorPane.bottomAnchor="153.6" AnchorPane.leftAnchor="30.0" />
      
        <TextField fx:id="txtFirstName" layoutX="250.0" layoutY="540.0" prefWidth="160.0" promptText="First Name" AnchorPane.bottomAnchor="154.4" AnchorPane.leftAnchor="460.0" />
        <TextField fx:id="txtLastName" layoutX="249.0" layoutY="540.0" prefWidth="160.0" promptText="Last Name" AnchorPane.bottomAnchor="154.39999999999998" AnchorPane.leftAnchor="249.0" />
        <DatePicker fx:id="dpDob" layoutX="680.0" layoutY="540.0" prefWidth="150.0" promptText="Date of Birth" AnchorPane.bottomAnchor="154.4" AnchorPane.leftAnchor="680.0" />
      
        <TextField fx:id="txtAddress" layoutX="30.0" layoutY="590.0" prefWidth="480.0" promptText="Complete Address" AnchorPane.bottomAnchor="104.39999999999998" AnchorPane.leftAnchor="30.0" />
        <TextField fx:id="txtContact" layoutX="545.0" layoutY="590.0" prefWidth="150.0" promptText="Contact Number" AnchorPane.bottomAnchor="104.39999999999998" AnchorPane.leftAnchor="545.0" />
      
        <Button layoutX="30.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleSaveCustomer" prefWidth="110.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="💾 Save New" AnchorPane.bottomAnchor="50.4" AnchorPane.leftAnchor="30.0" />
      
        <Button layoutX="159.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleUpdateCustomer" prefWidth="110.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="✏️ Update" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="159.0" />
      
        <Button layoutX="289.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleClearForm" prefWidth="110.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="Clear" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="289.0" />
      
        <Button layoutX="419.0" layoutY="640.0" mnemonicParsing="false" onAction="#handleDeleteCustomer" prefWidth="110.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="🗑️ Delete" AnchorPane.bottomAnchor="50.39999999999998" AnchorPane.leftAnchor="419.0" />
    </children>
</AnchorPane>
