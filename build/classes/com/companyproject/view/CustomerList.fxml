<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" styleClass="content-area" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.companyproject.controller.CustomerListController">
    <padding>
        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label styleClass="section-title" text="Customer Records" />
                        <Label fx:id="statusLabel" styleClass="status-text" text="Loading..." />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <ProgressIndicator fx:id="progressIndicator" maxHeight="26.0" maxWidth="26.0" />
                <JFXTextField fx:id="searchField" labelFloat="true" onAction="#handleSearch" prefWidth="260.0" promptText="Name, phone, or email" />
                <JFXButton fx:id="searchButton" buttonType="RAISED" onAction="#handleSearch" styleClass="secondary-button" text="Search" />
                <JFXButton fx:id="refreshButton" onAction="#handleRefresh" styleClass="secondary-button" text="Refresh" />
                <JFXButton fx:id="newCustomerButton" buttonType="RAISED" onAction="#handleNewCustomer" styleClass="primary-button" text="New Customer" />
            </children>
        </HBox>
        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="210.0" text="Name" />
                <TableColumn fx:id="mobileColumn" prefWidth="140.0" text="Mobile" />
                <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Email" />
                <TableColumn fx:id="cityColumn" prefWidth="140.0" text="City" />
                <TableColumn fx:id="idColumn" prefWidth="210.0" text="Primary ID" />
                <TableColumn fx:id="updatedColumn" prefWidth="150.0" text="Updated" />
            </columns>
        </TableView>
    </children>
</VBox>
